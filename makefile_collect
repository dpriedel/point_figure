# see link below for make file dependency magic
#
# http://bruno.defraine.net/techtips/makefile-auto-dependencies-with-gcc/
#
MAKE=gmake

BOOSTDIR := /extra/boost/boost-1.91_gcc-16
GCCDIR := /extra/gcc/gcc-16
GTESTDIR := /usr/local/include
UTILITYDIR := ${HOME}/projects/PF_Project/common_utilities
CPP := $(GCCDIR)/bin/g++
GCC := $(GCCDIR)/bin/gcc

# If no configuration is specified, "Debug" will be used
ifndef CFG
	CFG := Debug
endif

#	common definitions

CFG_INC := -I${HOME}/projects/PF_Project/point_figure/src \
	-I$(GTESTDIR) \
	-isystem$(BOOSTDIR) \
	-I/usr/local/include/ChartDirector \
	-I$(UTILITYDIR)/include # \

RPATH_LIB := -Wl,-rpath,$(GCCDIR)/lib64 -Wl,-rpath,$(BOOSTDIR)/lib -Wl,-rpath,/usr/local/lib -Wl,-rpath,/usr/local/lib/ChartDirector

CFG_LIB := -L../lib_PF_Chart \
		-lPF_Chart \
		-L/usr/local/lib \
		-lspdlog \
		-lpqxx \
		-lpq \
		-L/usr/local/lib/ChartDirector \
		-lchartdir \
		-L$(GCCDIR)/lib64 \
		-lstdc++ \
		-lstdc++exp \
		-L/usr/lib \
		-lmpdec++ \
		-lmpdec \
		-lcrypt \
		-lpthread \
		-lssl -lcrypto \
		-ljsoncpp  # \
		# -L$(BOOSTDIR)/lib \
		# -lboost_program_options-mt-x64 

# Rebuild this project
rebuild: cleanall all

# Clean this project and all dependencies
cleanall: clean

# ============================================================================
# pf_scanner target — NO ChartDirector dependency
# ============================================================================

SCANNER_OUTFILE := pf_scanner
ifeq "$(CFG)" "Debug"
SCANNER_OUTDIR := Debug_scanner
else
SCANNER_OUTDIR := Release_scanner
endif

SCANNER_INC := -I${HOME}/projects/PF_Project/point_figure/src \
	-I$(GTESTDIR) \
	-isystem$(BOOSTDIR) \
	-I$(UTILITYDIR)/include

SCANNER_LIB := -L../lib_PF_Chart \
		-lPF_Chart \
		-L/usr/local/lib \
		-lspdlog \
		-lpqxx \
		-lpq \
		-L$(GCCDIR)/lib64 \
		-lstdc++ \
		-lstdc++exp \
		-L/usr/lib \
		-lmpdec++ \
		-lmpdec \
		-lcrypt \
		-lpthread \
		-lssl -lcrypto \
		-ljsoncpp

SCANNER_RPATH := -Wl,-rpath,$(GCCDIR)/lib64 -Wl,-rpath,$(BOOSTDIR)/lib -Wl,-rpath,/usr/local/lib

ifeq "$(CFG)" "Debug"
SCANNER_CXXFLAGS := -O0 -g3 -std=c++26 -D_DEBUG -DBOOST_ENABLE_ASSERT_HANDLER -DSPDLOG_USE_STD_FORMAT -DUSE_OS_TZDB -DSHOW_STRACE -fPIC
SCANNER_LINK_CMD := $(CPP) -g -o $(SCANNER_OUTFILE)
endif

ifeq "$(CFG)" "Release"
SCANNER_CXXFLAGS := -O3 -std=c++26 -flto -DBOOST_ENABLE_ASSERT_HANDLER -DSPDLOG_USE_STD_FORMAT -DUSE_OS_TZDB -fPIC
SCANNER_LINK_CMD := $(CPP) -flto=auto -o $(SCANNER_OUTFILE)
endif

SCANNER_OBJS := $(SCANNER_OUTDIR)/scanner_main.o \
	$(SCANNER_OUTDIR)/PF_ScannerApp.o \
	$(SCANNER_OUTDIR)/PF_AppBase_scanner.o

.PHONY: all clean rebuild cleanall clean_scanner clean_streamer clean_loader clean_updater

$(SCANNER_OUTDIR):
	mkdir -p "$(SCANNER_OUTDIR)"

$(SCANNER_OUTDIR)/scanner_main.o: src/scanner/Main.cpp | $(SCANNER_OUTDIR)
	$(CPP) -c -x c++ $(SCANNER_CXXFLAGS) -o $@ $(SCANNER_INC) $< -march=native -mtune=native -MMD -MP

$(SCANNER_OUTDIR)/PF_ScannerApp.o: src/scanner/PF_ScannerApp.cpp | $(SCANNER_OUTDIR)
	$(CPP) -c -x c++ $(SCANNER_CXXFLAGS) -o $@ $(SCANNER_INC) $< -march=native -mtune=native -MMD -MP

$(SCANNER_OUTDIR)/PF_AppBase_scanner.o: src/common/PF_AppBase.cpp | $(SCANNER_OUTDIR)
	$(CPP) -c -x c++ $(SCANNER_CXXFLAGS) -o $@ $(SCANNER_INC) $< -march=native -mtune=native -MMD -MP

-include $(SCANNER_OBJS:.o=.d)

$(SCANNER_OUTFILE): $(SCANNER_OBJS) ../lib_PF_Chart/libPF_Chart.a
	$(SCANNER_LINK_CMD) $(SCANNER_OBJS) $(SCANNER_LIB) -Wl,-E $(SCANNER_RPATH)

